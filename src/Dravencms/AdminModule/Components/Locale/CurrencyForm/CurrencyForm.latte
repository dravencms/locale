<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="name">{_"Name"}</label>
                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="code">{_"Code"}</label>
                    <input type="text" n:name="code" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="sign">{_"Sign"}</label>
                    <input type="text" n:name="sign" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_"Active"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isDefault" class="form-check-input"> <span class="form-check-label">{_"Default"}</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <input type="submit" n:name="send" class="btn btn-success button" value="{_"Save"}">
        </div>
</form>